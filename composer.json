{
  "name": "larva/laravel-ai-volc",
  "description": "Volcengine Ark (火山方舟) provider for Laravel AI: text, embeddings, TTS, Seedream images and Seedance video.",
  "keywords": [
    "laravel",
    "laravel-ai",
    "volcengine",
    "volc",
    "ark",
    "doubao",
    "seedream",
    "seedance",
    "tts"
  ],
  "license": "MIT",
  "support": {
    "issues": "https://github.com/larva-cool/laravel-ai-volc/issues",
    "source": "https://github.com/larva-cool/laravel-ai-volc"
  },
  "authors": [
    {
      "name": "Larva Team",
      "email": "support@larva.com.cn"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/http": "^12.0 || ^13.0",
    "laravel/ai": "^0.10.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.3 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Larva\\Ai\\Volc\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Larva\\Ai\\Volc\\VolcServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-merge": "composer install",
    "check-style": "./vendor/bin/php-cs-fixer fix --using-cache=no --diff --dry-run --ansi",
    "fix-style": "./vendor/bin/php-cs-fixer fix --using-cache=no --ansi",
    "test": "./vendor/bin/phpunit --colors"
  },
  "scripts-descriptions": {
    "test": "Run all tests.",
    "check-style": "Run style checks (only dry run - no fixing!).",
    "fix-style": "Run style checks and fix violations."
  }
}
